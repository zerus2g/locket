{
  "version": 2,
  "rewrites": [
    {
      "source": "/dns-query/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dns-query",
      "destination": "/api/index.py"
    },
    {
      "source": "/locket_gold.mobileconfig",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/status.json",
      "destination": "/status.json"
    }
  ]
}
